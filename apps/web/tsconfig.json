{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // allowImportingTsExtensions：工作区包（@dforge/contracts / @dforge/engine）以 .ts 源码直供
    // （见 next.config.ts 的 transpilePackages），tsc 会把这些源文件拉进本包的程序，
    // 需与 contracts / engine / daemon 同开关（FE-02/FE-09 各自引入，合并后单点声明）。
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
