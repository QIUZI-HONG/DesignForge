{
  "extends": "../../tsconfig.base.json",
  // allowImportingTsExtensions：工作区包（@dforge/contracts）以 .ts 源码直供（见 next.config.ts
  // 的 transpilePackages），tsc 会把这些源文件拉进本包的程序，需与 contracts/daemon 同开关。
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    // 引用 @dforge/contracts（源码以显式 .ts 后缀的相对导入组织，与 daemon/ingest 同口径）；
    // 本包 noEmit，故该标志合法。
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
