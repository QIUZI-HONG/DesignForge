{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // 采集线各模块的 CLI 走 Node 原生 TS 类型擦除直跑（node src/collect/cli.ts、
    // src/transform/cli.ts、src/score/cli.ts、src/index/cli.ts 等），
    // 相对导入需显式带 .ts 后缀（Node ESM 不做无后缀解析）。
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
