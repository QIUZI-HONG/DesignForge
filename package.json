{
  "name": "designforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "设界 · DesignForge —— 本地优先的类 Figma 设计工作台（monorepo 根包）",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint && pnpm run lint:scripts",
    "lint:scripts": "biome check scripts .github",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "node --test \"scripts/tests/**/*.test.mjs\"",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:daemon": "node scripts/verify-daemon.mjs",
    "verify:resilience": "node scripts/verify-resilience.mjs",
    "verify:engine": "node scripts/verify-engine.mjs",
    "verify:mcp-stub": "node scripts/verify-mcp-stub.mjs",
    "verify:ai-two-state": "node scripts/verify-ai-two-state.mjs",
    "verify:image-two-state": "node scripts/verify-image-two-state.mjs",
    "verify:canvas": "node scripts/verify-canvas.mjs",
    "verify:market": "node scripts/verify-market.mjs",
    "verify:self-designed": "node scripts/verify-self-designed.mjs",
    "verify:shell-parity": "node scripts/verify-shell-parity.mjs",
    "verify:figma-baseline": "node scripts/verify-figma-baseline.mjs",
    "verify:figma-component": "node scripts/verify-figma-component.mjs",
    "verify:figma-editor": "node scripts/verify-figma-editor.mjs",
    "verify:figma-home": "node scripts/verify-figma-home.mjs",
    "verify:figma-inspect": "node scripts/verify-figma-inspect.mjs",
    "verify:figma-inspector": "node scripts/verify-figma-inspector.mjs",
    "verify:figma-panels": "node scripts/verify-figma-panels.mjs",
    "verify:figma-review": "node scripts/verify-figma-review.mjs",
    "verify:mk-01": "node scripts/verify-mk-01.mjs",
    "verify:mk-02": "node scripts/verify-mk-02.mjs",
    "verify:mk-03": "node scripts/verify-mk-03.mjs",
    "verify:mk-04": "node scripts/verify-mk-04.mjs",
    "verify:mk-05": "node scripts/verify-mk-05.mjs",
    "guard:deps": "node scripts/guard-deps.mjs",
    "guard:tokens": "node scripts/guard-tokens.mjs",
    "guard:vocab": "node scripts/guard-vocab.mjs",
    "guard:feature-boundaries": "node scripts/guard-feature-boundaries.mjs",
    "guard:channel-pairing": "node scripts/guard-channel-pairing.mjs",
    "guard:electron-baseline": "node scripts/guard-electron-baseline.mjs",
    "guard:mcp-contract": "node scripts/guard-mcp-contract.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "audit:editor-review": "node scripts/audit/editor-review-audit.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "axe-core": "catalog:",
    "pixelmatch": "catalog:",
    "playwright-core": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:"
  }
}
