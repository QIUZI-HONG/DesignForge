{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node_modules/.bin/vitest run --root packages/engine src/serialize/serialize.test.ts src/__verify__/serialize-edges.test.ts"
  },
  "mutate": ["packages/engine/src/serialize/serialize.ts"],
  "reporters": ["clear-text", "json", "html"],
  "concurrency": 2,
  "timeoutMS": 30000,
  "dryRunTimeoutMinutes": 5,
  "cleanTempDir": true,
  "ignorePatterns": [
    "apps/web/.next",
    "apps/web/public/canvaskit",
    "coverage",
    "**/coverage/**",
    "docs",
    "*.log"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
